{
  "name": "gamehub-api",
  "version": "1.0.0",
  "description": "REST API for the GameHub Android app: accounts, personal game lists and an IGDB proxy.",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/init-db.js",
    "test": "node --test",
    "test:unit": "node --test test/igdb.test.js test/validation.test.js",
    "test:integration": "node --test test/api.test.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.4"
  }
}