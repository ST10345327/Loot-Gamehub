<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/onboarding_skip"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="end"
        android:gravity="center"
        android:minWidth="64dp"
        android:text="@string/onboarding_skip"
        android:textColor="?attr/colorPrimary"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/onboarding_logo"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_marginTop="48dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/loot_gamehub" />

    <TextView
        android:id="@+id/onboarding_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:text="@string/onboarding_title_1"
        android:textAppearance="?attr/textAppearanceHeadline5"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/onboarding_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/onboarding_body_1"
        android:textAppearance="?attr/textAppearanceBody1" />

    <TextView
        android:id="@+id/onboarding_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:accessibilityLiveRegion="polite"
        android:text="●  ○  ○"
        android:textColor="?attr/colorPrimary"
        android:textSize="18sp" />

    <Button
        android:id="@+id/onboarding_next"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="@string/onboarding_next" />
</LinearLayout>
